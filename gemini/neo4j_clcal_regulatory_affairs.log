WHERE toFloat(obs.value) > 140
WITH s.usubjid, collect(obs) AS elevated_obs
WHERE size(elevated_obs) >= 2
WITH s.usubjid, size(elevated_obs) AS count_elevated
WHERE count_elevated > 1
