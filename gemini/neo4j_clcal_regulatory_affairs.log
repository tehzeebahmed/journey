 MATCH (s:Subject)-[:MADE_OBSERVATION]->(o:Observation)-[:MEASURED_ELEMENT]->(de:DataElement)-[:USES_TERM]->(ct:ControlledTerm {name: 'Systolic BP'})-<[:USES_TERM]-(de2:DataElement)
WHERE de.cdisc_variable = 'BPSYS'
WITH s.usubjid, collect(o) as observations
WHERE size(observations) >= 3
WITH s.usubjid, observations
