The Cypher is :
 ```
MATCH (s:Study)-[:HAS_TREATMENT]->(t:Treatment {name: 'Treatment A'})
WITH s, t
MATCH (s)-[:HAS_VISIT]->(v:Visit)
WHERE v.week <= 12 AND v.week >= -2
WITH s, t, v
MATCH (d:DataElement {cdisc_variable: 'BPSYS'})
MATCH (v)-[:COLLECTS]->(d)
MATCH (d)-[:USES_TERM]->(ct:ControlledTerm)
MATCH (s)-[:HAS_VISIT]->(v2:Visit)-[:COLLECTS]->(d2:DataElement {cdisc_variable: 'BPSYS'})
MATCH (s)-[:HAS_VISIT]->(v3:Visit)-[:COLLECTS]->(d3:DataElement {cdisc_variable: 'BPdia'})
MATCH (s)-[:HAS_VISIT]->(v4:Visit)-[:COLLECTS]->(d4:DataElement {cdisc_variable: 'BPmean'})
MATCH (s)-[:HAS_VISIT]->(v5:Visit)-[:COLLECTS]->(d5:DataElement {cdisc_variable: 'BPdia'})
WITH s, t, v, d, ct, v.week AS vw
MATCH (sub:Subject)-[:RECEIVES]->(t)
MATCH (sub)-[:MADE_OBSERVATION]->(o:Observation)-[:RECORDED_AT]->(v2)-[:MEASURED_ELEMENT]->(d2)
WHERE o.value IS NOT NULL AND o.value > 0
WITH s, t, v, vw, d, ct, collect(o.value) AS bp_systolic, collect(v2.week) AS v2w
MATCH (sub)-[:MADE_OBSERVATION]->(o2:Observation)-[:RECORDED_AT]->(v3)-[:MEASURED_ELEMENT]->(d3)
WHERE o2.value IS NOT NULL AND o2.value > 0
WITH s, t, v, vw, d, ct, bp_systolic, v2w, collect(o2.value) AS bp_diastolic, collect(v3.week) AS v3w
MATCH (sub)-[:MADE_OBSERVATION]->(o3:Observation)-[:RECORDED_AT]->(v4)-[:MEASURED_ELEMENT]->(d4)
WHERE o3.value IS NOT NULL AND o3.value > 0
WITH s, t, v, vw, d, ct, bp_systolic, v2w, bp_diastolic, v3w, collect(o3.value) AS bp_mean, collect(v4.week) AS v4w
MATCH (sub)-[:MADE_OBSERVATION]->(o4:Observation)-[:RECORDED_AT]->(v5)-[:MEASURED_ELEMENT]->(d5)
WHERE o4.value IS NOT NULL AND o4.value > 0
WITH s, t, vw, bp_systolic, v2w, bp_diastolic, v3w, bp_mean, v4w
RETURN
    vw AS week,
    avg(bp_systolic) AS avg_systolic_bp,
    avg(bp_diastolic) AS avg_diastolic_bp,
    avg(bp_mean) AS avg_mean_bp,
    count(bp_systolic) AS patient_count
